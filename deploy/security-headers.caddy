# GENERATED by frontend/scripts/deploy-headers.mjs on every build — edit config/security-headers.json instead.
header {
	Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-AgetG/BtVquD8quI7NUn6T6tLBOt6GCxk3o1uCxSyMI='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	Cross-Origin-Opener-Policy "same-origin"
	Strict-Transport-Security "max-age=300"
	-Server
}
