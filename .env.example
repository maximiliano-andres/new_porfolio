# Copy to .env and adjust. Read by docker compose.

# Local: ":80" (HTTP only). Production: your domain, e.g. "tudominio.cl" → Caddy obtains HTTPS automatically
# (the DNS A/AAAA record must point to this server and ports 80/443 must be open).
SITE_ADDRESS=:80

# Host ports (change them if 80/443 are taken locally, e.g. HTTP_PORT=8080)
HTTP_PORT=80
HTTPS_PORT=443

# HSTS: Caddy sends it on every response, starting at max-age=300 (gradual). After a week of stable HTTPS raise
# "hsts" in config/security-headers.json to max-age=31536000 and rebuild. ENABLE_HSTS only adds the same header in
# the backend, useful only if the API is ever served over HTTPS without Caddy in front.
ENABLE_HSTS=0

# ---- contact form ----
# Shared quota for ALL visitors together (stored messages per hour; above it → 429). 0 disables it.
# Per-visitor quota: 5 per 10 min, IPv6 grouped by /64 (CONTACT_RATE_LIMIT, CONTACT_RATE_WINDOW_S, CONTACT_IPV6_PREFIX)
CONTACT_GLOBAL_LIMIT=100
# Size cap of the contact log (MB); above it new messages get 503 until you archive/purge it. 0 disables it.
CONTACT_LOG_MAX_MB=50
# Retention: messages older than this are deleted (at startup and at most once a day). Keep it in line with the
# privacy notice under the form ("se eliminan a los 12 meses"). 0 keeps them forever.
CONTACT_RETENTION_DAYS=365
# Optional notification for each new message: an https:// incoming-webhook URL (Slack, Discord, Mattermost, ntfy…).
# Sent in the background (5 s timeout) AFTER the message is stored; a failure is only logged. The payload carries no
# personal data (no name, email or message: read them from the contact log). Empty = disabled. Treat it as a secret.
CONTACT_NOTIFY_WEBHOOK=
# /api/status answers 503 (monitoring alert) when the contact log's disk has less free space than this (MB)
MIN_FREE_DISK_MB=100
