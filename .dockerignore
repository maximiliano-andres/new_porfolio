# Keep the build context small: everything is rebuilt inside the image.
# The Dockerfile only reads frontend/, backend/app, backend/requirements.lock, config/ and deploy/Caddyfile.
.git
.github
.gitignore
.gitattributes
**/node_modules
**/dist
**/dist-ssr
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/contact_messages.jsonl
backend/tests
docs
README.md
.env
.env.*
!.env.example
Dockerfile
docker-compose*.yml
.dockerignore
.DS_Store
.vscode
.idea
